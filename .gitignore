*.iml
.gradle
.kotlin
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
build/
/captures
.externalNativeBuild
.cxx
local.properties

# Configuración de Firebase — nunca versionar
google-services.json

# Llaves de firma — nunca versionar
*.keystore
*.jks

# Llave de servicio de Firebase (siembra local) — nunca versionar; la ruta
# canónica es ~/.config/aurora-seed/ FUERA del repo, esto es doble barrera
service-account*.json
*-adminsdk-*.json

# Copias de los borradores obsoletos del panel (limpiar-borradores.mjs) — llevan
# el contenido de los documentos. La ruta canónica es
# ~/.config/aurora-seed/respaldos/ FUERA del repo y el propio comando rechaza
# escribir dentro; esto es doble barrera.
borradores-obsoletos-*.json
tools/seed/node_modules/
tools/admin/node_modules/

# Panel web de administración (admin/) — dependencias, build y env local
admin/node_modules/
admin/dist/
admin/.env
admin/.env.local
admin/.env.*.local

# Artefactos de sesión de Claude Code (los agentes en .claude/agents/ sí se versionan)
/.claude/projects/
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# Archivos temporales de editores (swap de Vim, respaldos)
*.swp
*.swo
*~

# Capturas y archivos exportados de las corridas manuales en emulador — llevan
# contenido del espacio interno, y los PDF llevan registros reales. La ruta
# canónica es el directorio temporal de la sesión FUERA del repo; esto es doble
# barrera por si alguna se copia aquí para mirarla.
# Va por carpeta y por prefijo A PROPÓSITO, no con `*.png`: las imágenes que SÍ
# se versionan son docs/mockups/, docs/mockups-v2/, docs/evidencias-owasp/ y
# docs/manual-de-marca.pdf, y ninguna cae en estos patrones.
/evidencias-corrida/
capturas-api*/
captura-*.png
export-*.pdf
