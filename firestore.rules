rules_version = '2';

// Reglas de acceso de Firestore (RNF-06, RF-37; P-04).
//
// Dos mundos separados y sin puentes:
//   1. Contenido administrable (topics/routes/agencies/lines/forms): solo lectura
//      para cualquier usuaria autenticada; se escribe únicamente con credenciales
//      administrativas (siembra / futuro panel) que no pasan por estas reglas.
//   2. Datos de la usuaria (/users/{uid}/**): lectura y escritura EXCLUSIVAS de su
//      propia cuenta. Ni un rol administrativo (otro uid) puede leerlos (RNF-06);
//      y aunque pudiera, el contenido viaja cifrado desde el cliente (RF-37/RNF-01),
//      así que el proyecto de Firebase nunca ve texto en claro.
// Todo lo demás queda negado por defecto.
service cloud.firestore {
  match /databases/{database}/documents {
    match /topics/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /routes/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /agencies/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /lines/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /forms/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Registros cifrados de la usuaria (RF-37): solo su dueña, autenticada.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
