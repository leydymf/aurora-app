# Configuración del SDK web de Firebase para el panel (proyecto aurora-31c37).
#
# IMPORTANTE: estos valores NO son secretos. La config web de Firebase viaja en
# cualquier bundle de cliente (igual que ya viaja en el google-services.json del
# APK). La seguridad real la dan firestore.rules + el custom claim `admin`, no el
# ocultamiento de estas claves. Se usan variables de entorno solo por higiene y
# para no hardcodearlas en el código.
#
# Copia este archivo a `.env` y rellena con los valores de:
#   Consola de Firebase -> Configuracion del proyecto -> Tus apps -> App web -> SDK.
# Si aun no existe una app web en el proyecto, crea una (icono </>) — no altera
# el APK Android existente.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=aurora-31c37.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aurora-31c37
VITE_FIREBASE_STORAGE_BUCKET=aurora-31c37.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
