    <string name="account_intro_keep_body">Tu correo y contraseña; tu clave personal, protegida y nunca legible; y solo los registros o resultados que tú decidas guardar.</string>
    <string name="account_intro_avoid_title">Qué no hacemos.</string>
    <string name="account_intro_avoid_body">No compartimos tus datos con nadie. No enviamos notificaciones. Nada sale de aquí.</string>
    <string name="account_intro_rights_title">Tus derechos.</string>
